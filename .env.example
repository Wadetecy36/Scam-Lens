# Server Configuration
PORT=3001
NODE_ENV=development

# Gemini API (Required for real AI analysis, defaults to mock if absent)
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3.5-flash-lite

# VirusTotal API (Optional - for URL reputation scanning)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Client-safe configuration only. Never put API keys or server credentials here.
VITE_APP_ENV=development
VITE_APP_URL=http://localhost:5173
VITE_ANALYTICS_ENABLED=false
VITE_USE_MOCK_ANALYSIS=true
